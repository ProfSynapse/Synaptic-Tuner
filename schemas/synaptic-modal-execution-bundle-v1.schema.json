{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://synapticlabs.ai/schemas/synaptic-modal-execution-bundle-v1.schema.json",
  "title": "Synaptic Modal execution bundle v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "grant_ref", "effect", "invocation_nonce", "members"],
  "properties": {
    "schema_version": {"const": "synaptic-modal-execution-bundle/v1"},
    "grant_ref": {"$ref": "#/$defs/ref"},
    "invocation_nonce": {"$ref": "#/$defs/ref"},
    "effect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["effect_id", "effect_key", "kind", "scope"],
      "properties": {
        "effect_id": {"$ref": "#/$defs/ref"},
        "effect_key": {"$ref": "#/$defs/ref"},
        "kind": {"enum": ["submit", "cancel"]},
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": ["provider", "account_ref", "namespace_ref"],
          "properties": {
            "provider": {"const": "modal"},
            "account_ref": {"$ref": "#/$defs/ref"},
            "namespace_ref": {"$ref": "#/$defs/ref"}
          }
        }
      }
    },
    "members": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/member"},
      "allOf": [
        {"contains": {"properties": {"name": {"const": "artifact-contract.json"}}}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"name": {"const": "deployment.json"}}}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"name": {"const": "execution-source.json"}}}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"name": {"const": "invocation-intent.json"}}}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"name": {"const": "log-terminal-policy.json"}}}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"name": {"const": "plan.json"}}}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"name": {"const": "stage-intent.json"}}}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"name": {"const": "worker-closure-manifest.json"}}}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"name": {"const": "workload.json"}}}, "minContains": 1, "maxContains": 1}
      ]
    }
  },
  "$defs": {
    "ref": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+-]*$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "member": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "decoded_size", "encoded_size", "sha256", "content_base64"],
      "properties": {
        "name": {"enum": ["artifact-contract.json", "deployment.json", "execution-source.json", "invocation-intent.json", "log-terminal-policy.json", "plan.json", "stage-intent.json", "worker-closure-manifest.json", "workload.json"]},
        "decoded_size": {"type": "integer", "minimum": 1, "maximum": 1048576},
        "encoded_size": {"type": "integer", "minimum": 4, "maximum": 1398104},
        "sha256": {"$ref": "#/$defs/sha256"},
        "content_base64": {"type": "string", "minLength": 4, "maxLength": 1398104, "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"}
      }
    }
  }
}
