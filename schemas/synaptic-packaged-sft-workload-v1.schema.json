{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.synapticlabs.ai/synaptic-packaged-sft-workload-v1.schema.json",
  "title": "Provider-neutral packaged SFT workload v1",
  "description": "Acyclic workload compiled before execution binding. Canonical compilation additionally validates finite numeric bounds, logical references, prepared controls and cross-field/digest equality. No Git source, launch command or provider-native object is admitted.",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "method", "entrypoint", "configuration", "identities", "runtime_requirements", "artifacts"],
  "properties": {
    "schema_version": {"const": "synaptic-packaged-sft-workload/v1"},
    "method": {"const": "sft"},
    "entrypoint": {"const": "tuner.runtime.packaged_training_worker:main"},
    "configuration": {
      "type": "object", "additionalProperties": false, "required": ["digest", "document"],
      "properties": {"digest": {"$ref": "#/$defs/digest"}, "document": {"$ref": "#/$defs/config"}}
    },
    "identities": {
      "type": "object", "additionalProperties": false, "required": ["model", "dataset"],
      "properties": {"model": {"$ref": "#/$defs/model"}, "dataset": {"$ref": "#/$defs/prepared"}}
    },
    "runtime_requirements": {
      "const": {"schema_version": "synaptic-packaged-sft-runtime-requirements/v1", "offline_trainer": true, "credential_free_trainer": true}
    },
    "artifacts": {
      "const": {
        "schema_version": "synaptic-sft-artifacts/v1",
        "requirements": [
          {"role": "workload_record", "minimum": 1, "maximum": 1},
          {"role": "training_lineage", "minimum": 1, "maximum": 1},
          {"role": "training_metrics", "minimum": 1, "maximum": 1},
          {"role": "final_model", "minimum": 1, "maximum": 1},
          {"role": "tokenizer", "minimum": 1, "maximum": 1}
        ]
      }
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "revision": {"type": "string", "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"},
    "model": {
      "type": "object", "additionalProperties": false,
      "required": ["ref", "revision", "tokenizer_revision", "load_in_4bit"],
      "properties": {
        "ref": {"type": "string", "minLength": 1, "maxLength": 512},
        "revision": {"$ref": "#/$defs/revision"}, "tokenizer_revision": {"$ref": "#/$defs/revision"},
        "load_in_4bit": {"type": "boolean"}
      }
    },
    "prepared": {
      "type": "object", "additionalProperties": false,
      "required": ["ref", "revision", "content_digest", "size_bytes", "format"],
      "properties": {
        "ref": {"type": "string", "pattern": "^prepared://sha256/[0-9a-f]{64}$"},
        "revision": {"$ref": "#/$defs/digest"}, "content_digest": {"$ref": "#/$defs/digest"},
        "size_bytes": {"type": "integer", "minimum": 1, "maximum": 67108864},
        "format": {"enum": ["syntunia-sft-row/v1", "syntunia-sft-row/v2"]}
      }
    },
    "config": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "method", "execution", "model", "dataset", "sft"],
      "properties": {
        "schema_version": {"const": "synaptic-packaged-sft-config/v1"}, "method": {"const": "sft"},
        "execution": {"const": {"mode": "packaged_runtime"}},
        "model": {"$ref": "#/$defs/model"}, "dataset": {"$ref": "#/$defs/prepared"},
        "sft": {"$ref": "#/$defs/hyperparameters"}
      }
    },
    "hyperparameters": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "batch_size", "gradient_accumulation_steps", "learning_rate", "duration", "max_seq_length", "seed", "save_steps", "save_total_limit", "lora_rank", "lora_alpha", "lora_dropout", "lora_target_modules", "use_dora", "use_rslora", "init_lora_weights", "split_dataset", "dataset_format", "completion_only_loss", "assistant_only_loss", "use_preassigned_splits", "prompt_render", "packing", "require_memory_efficient_loss"],
      "properties": {
        "schema_version": {"const": "synaptic-sft-hyperparameters/v1"},
        "batch_size": {"type": "integer", "minimum": 1, "maximum": 4096},
        "gradient_accumulation_steps": {"type": "integer", "minimum": 1, "maximum": 4096},
        "learning_rate": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "duration": {
          "type": "object", "additionalProperties": false, "required": ["max_steps", "num_epochs"],
          "oneOf": [
            {"properties": {"max_steps": {"type": "integer", "minimum": 1, "maximum": 10000000}, "num_epochs": {"type": "null"}}},
            {"properties": {"max_steps": {"type": "null"}, "num_epochs": {"type": "number", "exclusiveMinimum": 0, "maximum": 1000}}}
          ],
          "properties": {"max_steps": {}, "num_epochs": {}}
        },
        "max_seq_length": {"type": "integer", "minimum": 1, "maximum": 1048576},
        "seed": {"type": "integer", "minimum": 0, "maximum": 4294967295},
        "save_steps": {"type": "integer", "minimum": 1, "maximum": 10000000},
        "save_total_limit": {"type": "integer", "minimum": 1, "maximum": 10000},
        "lora_rank": {"type": "integer", "minimum": 1, "maximum": 4096},
        "lora_alpha": {"type": "integer", "minimum": 1, "maximum": 65536},
        "lora_dropout": {"type": "number", "minimum": 0, "exclusiveMaximum": 1},
        "lora_target_modules": {"type": "array", "minItems": 1, "maxItems": 256, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128}},
        "use_dora": {"type": "boolean"}, "use_rslora": {"type": "boolean"},
        "init_lora_weights": {"type": "boolean"}, "split_dataset": {"const": false},
        "dataset_format": {"enum": ["raw_text", "messages"]},
        "completion_only_loss": {"type": "boolean"}, "assistant_only_loss": {"type": "boolean"},
        "use_preassigned_splits": {"const": true},
        "prompt_render": {"enum": ["full_conversation", "prompt_completion"]},
        "packing": {"type": "boolean"}, "require_memory_efficient_loss": {"type": "boolean"}
      }
    }
  }
}
