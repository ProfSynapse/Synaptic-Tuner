{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.synapticlabs.ai/synaptic-packaged-grpo-training-lineage-v1.schema.json",
  "$comment": "Structural validation is not authority. Native GRPO verification reconstructs the original child payload and binds private model, dataset, workload and actual exit evidence. Steps alone do not prove parameter changes or reward dispersion.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "runtime_release_digest",
    "provider_runtime_binding_digest",
    "execution_binding_digest",
    "workload_fingerprint",
    "configuration_digest",
    "artifact_policy_digest",
    "run_ref",
    "prepared_input",
    "model_snapshot",
    "trainer_lineage",
    "status",
    "trainer_exit_code",
    "child_transport_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "synaptic-packaged-grpo-training-lineage/v1"
    },
    "runtime_release_digest": {
      "$ref": "#/$defs/digest"
    },
    "provider_runtime_binding_digest": {
      "$ref": "#/$defs/digest"
    },
    "execution_binding_digest": {
      "$ref": "#/$defs/digest"
    },
    "workload_fingerprint": {
      "$ref": "#/$defs/digest"
    },
    "configuration_digest": {
      "$ref": "#/$defs/digest"
    },
    "artifact_policy_digest": {
      "$ref": "#/$defs/digest"
    },
    "run_ref": {
      "type": "string",
      "minLength": 1
    },
    "prepared_input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "revision",
        "content_digest",
        "size_bytes",
        "format"
      ],
      "properties": {
        "ref": {
          "type": "string",
          "pattern": "^prepared://sha256/[0-9a-f]{64}$"
        },
        "revision": {
          "$ref": "#/$defs/digest"
        },
        "content_digest": {
          "$ref": "#/$defs/digest"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65536
        },
        "format": {
          "const": "synaptic-grpo-prompts/v1"
        }
      }
    },
    "model_snapshot": {
      "$ref": "#/$defs/snapshot"
    },
    "trainer_lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "model",
        "input_commitments",
        "reward_plan",
        "actual_steps"
      ],
      "properties": {
        "method": {
          "const": "grpo"
        },
        "model": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "model_id",
            "revision",
            "tokenizer_revision"
          ],
          "properties": {
            "model_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "revision": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "tokenizer_revision": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            }
          }
        },
        "input_commitments": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "config_sha256",
            "dataset_sha256",
            "rewards_sha256"
          ],
          "properties": {
            "config_sha256": {
              "$ref": "#/$defs/digest"
            },
            "dataset_sha256": {
              "$ref": "#/$defs/digest"
            },
            "rewards_sha256": {
              "$ref": "#/$defs/digest"
            }
          }
        },
        "reward_plan": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "name",
              "weight",
              "source"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "weight": {
                "type": "number",
                "minimum": 0,
                "maximum": 1000
              },
              "source": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "type": {
                "const": "rubric"
              }
            }
          }
        },
        "actual_steps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        }
      }
    },
    "status": {
      "const": "completed"
    },
    "trainer_exit_code": {
      "type": "integer",
      "const": 0
    },
    "child_transport_sha256": {
      "$ref": "#/$defs/digest"
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root",
        "device",
        "inode",
        "members"
      ],
      "properties": {
        "root": {
          "type": "string",
          "pattern": "packaged-model-[0-9a-f]{32}$"
        },
        "device": {
          "type": "integer",
          "minimum": 0
        },
        "inode": {
          "type": "integer",
          "minimum": 0
        },
        "members": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "size_bytes",
              "sha256",
              "device",
              "inode"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "size_bytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 34359738368
              },
              "sha256": {
                "$ref": "#/$defs/digest"
              },
              "device": {
                "type": "integer",
                "minimum": 0
              },
              "inode": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    }
  }
}
