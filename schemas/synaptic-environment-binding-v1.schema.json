{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.synapticlabs.ai/synaptic-environment-binding-v1.schema.json",
  "title": "Host-resolved environment binding v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "selection",
    "backend_ref",
    "backend_revision",
    "scope_ref",
    "bounds",
    "allowed_actions",
    "dependencies"
  ],
  "properties": {
    "schema_version": {
      "const": "synaptic-environment-binding/v1"
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_ref",
        "mode"
      ],
      "properties": {
        "profile_ref": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
        },
        "mode": {
          "enum": [
            "execute",
            "simulate"
          ]
        }
      }
    },
    "backend_ref": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
    },
    "backend_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "scope_ref": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
    },
    "bounds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_rows",
        "max_turns",
        "max_tool_calls",
        "max_fixture_files",
        "max_fixture_bytes",
        "max_output_bytes",
        "max_snapshot_bytes",
        "max_seconds"
      ],
      "properties": {
        "max_rows": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "max_turns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "max_tool_calls": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "max_fixture_files": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "max_fixture_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16777216
        },
        "max_output_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16777216
        },
        "max_snapshot_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16777216
        },
        "max_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        }
      }
    },
    "allowed_actions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
      }
    },
    "dependencies": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "ref",
          "sha256",
          "size_bytes"
        ],
        "properties": {
          "role": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
          },
          "ref": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4194304
          }
        }
      }
    }
  }
}
