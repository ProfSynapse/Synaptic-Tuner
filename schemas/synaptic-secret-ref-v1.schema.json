{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.synapticlabs.ai/synaptic-secret-ref-v1.schema.json",
  "title": "Synaptic Secret Reference v1",
  "type": "object",
  "required": ["provider", "name"],
  "properties": {
    "provider": {
      "type": "string",
      "enum": ["env", "provider_secret", "credential_helper"]
    },
    "name": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:/-]{0,127}$"
    }
  },
  "additionalProperties": false
}
