{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.synapticlabs.ai/synaptic-grpo-hyperparameters-v1.schema.json",
  "type": "object",
  "properties": {
    "batch_size": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4096
    },
    "gradient_accumulation_steps": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4096
    },
    "num_generations": {
      "type": "integer",
      "minimum": 2,
      "maximum": 4096
    },
    "max_steps": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100000
    },
    "max_seq_length": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100000
    },
    "max_prompt_length": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100000
    },
    "max_completion_length": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100000
    },
    "logging_steps": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100000
    },
    "save_steps": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100000
    },
    "save_total_limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100000
    },
    "lora_rank": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4096
    },
    "lora_alpha": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65536
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "learning_rate": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 1
    },
    "temperature": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 10
    },
    "max_grad_norm": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 100
    },
    "beta": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "weight_decay": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "warmup_ratio": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "lora_dropout": {
      "type": "number",
      "minimum": 0,
      "exclusiveMaximum": 1
    },
    "lora_target_modules": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    },
    "use_dora": {
      "type": "boolean"
    },
    "use_rslora": {
      "type": "boolean"
    },
    "load_in_4bit": {
      "type": "boolean"
    },
    "bf16": {
      "type": "boolean"
    },
    "fp16": {
      "type": "boolean"
    },
    "prompt_column": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "schema_version": {
      "const": "synaptic-grpo-hyperparameters/v1"
    },
    "chat_template_kwargs": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 64
    }
  },
  "required": [
    "batch_size",
    "gradient_accumulation_steps",
    "num_generations",
    "max_steps",
    "max_seq_length",
    "max_prompt_length",
    "max_completion_length",
    "logging_steps",
    "save_steps",
    "save_total_limit",
    "lora_rank",
    "lora_alpha",
    "seed",
    "learning_rate",
    "temperature",
    "max_grad_norm",
    "beta",
    "weight_decay",
    "warmup_ratio",
    "lora_dropout",
    "lora_target_modules",
    "use_dora",
    "use_rslora",
    "load_in_4bit",
    "bf16",
    "fp16",
    "prompt_column",
    "schema_version"
  ],
  "additionalProperties": false
}
