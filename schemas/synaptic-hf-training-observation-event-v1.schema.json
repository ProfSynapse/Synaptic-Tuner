{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://schemas.synapticlabs.ai/synaptic-hf-training-observation-event-v1.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "event_id", "authorization_id", "approval", "submission", "provider_job", "experiment_id", "run_id", "tracking_root_id", "state", "terminal", "occurred_at", "previous_event", "status_intervals", "hourly_price_usd", "estimated_cost_usd", "cost_bounded_completion"],
  "properties": {
    "schema_version": {"const": "synaptic-hf-training-observation-event/v1"}, "event_id": {"$ref": "#/$defs/sha256"}, "authorization_id": {"$ref": "#/$defs/sha256"}, "approval": {"$ref": "#/$defs/artifactRef"}, "submission": {"$ref": "#/$defs/artifactRef"}, "provider_job": {"$ref": "#/$defs/providerJob"},
    "experiment_id": {"$ref": "#/$defs/segment"}, "run_id": {"$ref": "#/$defs/segment"}, "tracking_root_id": {"$ref": "#/$defs/sha256"}, "state": {"enum": ["COMPLETED", "ERROR", "CANCELLED", "STOPPED"]}, "terminal": {"type": "boolean"}, "occurred_at": {"$ref": "#/$defs/timestamp"}, "previous_event": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/artifactRef"}]},
    "status_intervals": {"type": "array", "minItems": 1, "maxItems": 4096, "items": {"type": "object", "additionalProperties": false, "required": ["status", "started_at", "ended_at"], "properties": {"status": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,63}$"}, "started_at": {"$ref": "#/$defs/timestamp"}, "ended_at": {"$ref": "#/$defs/timestamp"}}}},
    "hourly_price_usd": {"type": "string", "pattern": "^(?:0|1)(?:\\.[0-9]{1,6})?$"}, "estimated_cost_usd": {"type": "string", "pattern": "^[0-9]+(?:\\.[0-9]{1,6})?$"}, "cost_bounded_completion": {"type": "boolean"}
  },
  "allOf": [
    {"if": {"properties": {"state": {"const": "STOPPED"}}}, "then": {"properties": {"terminal": {"const": false}, "cost_bounded_completion": {"const": false}}}},
    {"if": {"properties": {"state": {"enum": ["COMPLETED", "ERROR", "CANCELLED"]}}}, "then": {"properties": {"terminal": {"const": true}}}}
  ],
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "segment": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"}, "timestamp": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$"}, "artifactRef": {"type": "object", "additionalProperties": false, "required": ["uri", "sha256"], "properties": {"uri": {"type": "string", "pattern": "^tracking://[A-Za-z0-9][A-Za-z0-9._/-]*$"}, "sha256": {"$ref": "#/$defs/sha256"}}}, "providerJob": {"type": "object", "additionalProperties": false, "required": ["namespace", "job_id", "created_at"], "properties": {"namespace": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"}, "job_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"}, "created_at": {"$ref": "#/$defs/timestamp"}}}}
}
