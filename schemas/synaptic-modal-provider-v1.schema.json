{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://synapticlabs.ai/schemas/synaptic-modal-provider-v1.schema.json",
  "title": "Synaptic Modal Provider Profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile", "deployment", "runtime_lock", "volumes", "secrets"],
  "properties": {
    "schema_version": {"const": "synaptic-modal-provider/v1"},
    "profile": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._+@/-]{0,255}$"},
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["app_name", "function_name", "function_version", "image_id"],
      "properties": {
        "app_name": {"const": "synaptic-training-v1"},
        "function_name": {"const": "run_sft_v1"},
        "function_version": {"type": "string", "pattern": "^[1-9][0-9]*$"},
        "image_id": {"type": "string", "pattern": "^im-[A-Za-z0-9._+-]+$"}
      }
    },
    "runtime_lock": {"type": "string", "pattern": "^engine://tuner/execution/providers/modal/modal-runtime-v1\\.lock\\.json$"},
    "volumes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["control_ref", "artifact_ref"],
      "properties": {
        "control_ref": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._+@/-]{0,255}$"},
        "artifact_ref": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._+@/-]{0,255}$"}
      }
    },
    "secrets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["provider", "name", "required_keys"],
        "properties": {
          "provider": {"const": "modal"},
          "name": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._+@/-]{0,255}$"},
          "required_keys": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,127}$"}
          }
        }
      }
    }
  }
}
