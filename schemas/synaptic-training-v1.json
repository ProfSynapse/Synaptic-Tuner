{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.synapticlabs.ai/synaptic-training-v1.json",
  "title": "Synaptic SFT Training Request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "method",
    "model",
    "dataset",
    "sft",
    "execution",
    "artifacts"
  ],
  "properties": {
    "schema_version": {
      "const": "synaptic.training/v1"
    },
    "kind": {
      "const": "training"
    },
    "method": {
      "const": "sft"
    },
    "model": {
      "$ref": "#/$defs/model"
    },
    "dataset": {
      "$ref": "#/$defs/dataset"
    },
    "sft": {
      "$ref": "#/$defs/sft"
    },
    "execution": {
      "$ref": "#/$defs/execution"
    },
    "artifacts": {
      "$ref": "#/$defs/artifacts"
    }
  },
  "$defs": {
    "repo": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}/[A-Za-z0-9][A-Za-z0-9._-]{0,95}$"
    },
    "revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "decimal": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*(\\.[0-9]*[1-9])?|0\\.[0-9]*[1-9])$"
        },
        {
          "type": "number",
          "minimum": 0
        }
      ]
    },
    "positiveDecimal": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^([1-9][0-9]*(\\.[0-9]*[1-9])?|0\\.[0-9]*[1-9])$"
        },
        {
          "type": "number",
          "exclusiveMinimum": 0
        }
      ]
    },
    "ratio": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^(0|1|0\\.[0-9]*[1-9])$"
        },
        {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      ]
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identifier"
      ],
      "properties": {
        "identifier": {
          "$ref": "#/$defs/repo"
        },
        "revision": {
          "$ref": "#/$defs/revision"
        },
        "tokenizer_revision": {
          "$ref": "#/$defs/revision"
        },
        "trust_remote_code": {
          "const": false
        }
      }
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identifier"
      ],
      "properties": {
        "identifier": {
          "$ref": "#/$defs/repo"
        },
        "revision": {
          "$ref": "#/$defs/revision"
        },
        "split": {
          "type": "string",
          "pattern": "^(?!.*[?#\\\\])[!-~]{1,128}$"
        },
        "file": {
          "type": "string",
          "pattern": "^(?!/)(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9._/-]+\\.(?:json|jsonl)$",
          "maxLength": 512
        }
      }
    },
    "sft": {
      "type": "object",
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "max_steps"
          ],
          "not": {
            "required": [
              "epochs"
            ]
          }
        },
        {
          "required": [
            "epochs"
          ],
          "not": {
            "required": [
              "max_steps"
            ]
          }
        }
      ],
      "properties": {
        "max_steps": {
          "type": "integer",
          "minimum": 1
        },
        "epochs": {
          "$ref": "#/$defs/positiveDecimal"
        },
        "per_device_train_batch_size": {
          "type": "integer",
          "minimum": 1,
          "default": 1
        },
        "gradient_accumulation_steps": {
          "type": "integer",
          "minimum": 1,
          "default": 1
        },
        "learning_rate": {
          "$ref": "#/$defs/positiveDecimal"
        },
        "max_seq_length": {
          "type": "integer",
          "minimum": 1,
          "default": 2048
        },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "default": 3407
        },
        "warmup_ratio": {
          "$ref": "#/$defs/ratio"
        },
        "weight_decay": {
          "$ref": "#/$defs/decimal"
        },
        "adapter_rank": {
          "type": "integer",
          "minimum": 1,
          "default": 16
        },
        "adapter_alpha": {
          "type": "integer",
          "minimum": 1,
          "default": 16
        },
        "adapter_dropout": {
          "$ref": "#/$defs/ratio"
        },
        "record_format": {
          "const": "conversations"
        },
        "loss_scope": {
          "enum": [
            "assistant_messages",
            "full_sequence"
          ]
        },
        "prompt_render": {
          "const": "full_conversation"
        },
        "optimizer": {
          "const": "adamw_8bit"
        },
        "scheduler": {
          "const": "linear"
        },
        "max_grad_norm": {
          "$ref": "#/$defs/positiveDecimal"
        },
        "compute_dtype": {
          "const": "bf16"
        },
        "model_quantization": {
          "const": "none"
        },
        "gradient_checkpointing": {
          "const": "unsloth"
        },
        "logging_steps": {
          "type": "integer",
          "minimum": 1,
          "default": 1
        },
        "checkpoint_strategy": {
          "enum": [
            "none",
            "steps"
          ]
        },
        "checkpoint_steps": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "checkpoint_limit": {
          "type": "integer",
          "minimum": 0
        },
        "packing": {
          "const": false
        },
        "adapter_initialization": {
          "const": "default"
        },
        "use_rslora": {
          "const": false
        },
        "use_dora": {
          "const": false
        },
        "target_modules": {
          "type": "array",
          "maxItems": 0
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "checkpoint_strategy": {
                "const": "steps"
              }
            },
            "required": [
              "checkpoint_strategy"
            ]
          },
          "then": {
            "required": [
              "checkpoint_steps"
            ],
            "properties": {
              "checkpoint_limit": {
                "minimum": 1
              }
            }
          },
          "else": {
            "properties": {
              "checkpoint_steps": {
                "type": "null"
              },
              "checkpoint_limit": {
                "const": 0
              }
            }
          }
        }
      ]
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
        },
        "accelerator": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "accelerator_count": {
          "type": "integer",
          "minimum": 1
        },
        "runtime_image": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "runtime_image_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "dependency_lock_digest": {
          "$ref": "#/$defs/digest"
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "maximum_cost_minor_units": {
          "type": "integer",
          "minimum": 0
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "allowed_secret_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(secret|credential)://[A-Za-z0-9_-]+(?:/[A-Za-z0-9._-]+)*$"
          }
        }
      },
      "dependentRequired": {
        "maximum_cost_minor_units": [
          "currency"
        ],
        "currency": [
          "maximum_cost_minor_units"
        ]
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "retain_checkpoints": {
          "type": "boolean"
        },
        "publish_final_model": {
          "type": "boolean"
        },
        "publication_ref": {
          "type": "string",
          "pattern": "^publication://[A-Za-z0-9_-]+(?:/[A-Za-z0-9._-]+)*$"
        }
      }
    }
  }
}
