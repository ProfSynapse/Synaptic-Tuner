{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.synapticlabs.ai/synaptic-evaluation-plan-v1.schema.json",
  "title": "Synaptic Evaluation Plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request", "cases_total", "scenario_digest"],
  "$defs": {
    "text": {"type": "string", "pattern": "^(?!\\s)(?!.*[\\u0000-\\u001f\\u007f]).*\\S$"},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "properties": {
    "schema_version": {"const": "synaptic-evaluation-plan/v1"},
    "request": {
      "type": "object", "additionalProperties": false,
      "required": ["request_id", "project_ref", "model", "backend", "scenario_refs", "preset", "tags", "case_limit"],
      "properties": {
        "request_id": {"$ref": "#/$defs/text"},
        "project_ref": {"$ref": "#/$defs/text"},
        "model": {
          "type": "object", "additionalProperties": false,
          "required": ["model_ref", "model_revision"],
          "properties": {
            "model_ref": {"$ref": "#/$defs/text"},
            "model_revision": {"$ref": "#/$defs/text"}
          }
        },
        "backend": {"$ref": "#/$defs/text"},
        "scenario_refs": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"$ref": "#/$defs/text"}
        },
        "preset": {"type": ["string", "null"], "pattern": "^(?!\\s)(?!.*[\\u0000-\\u001f\\u007f]).*\\S$"},
        "tags": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
        "case_limit": {"type": ["integer", "null"], "minimum": 1}
      }
    },
    "cases_total": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
    "scenario_digest": {"$ref": "#/$defs/digest"}
  }
}
