{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.synapticlabs.ai/synaptic-dataset-plan-v2.schema.json",
  "title": "Opt-in environment dataset plan v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request",
    "scenarios",
    "rows_requested",
    "source_digest",
    "environment_binding"
  ],
  "$defs": {
    "text": {
      "type": "string",
      "pattern": "^(?!\\s)(?!.*[\\u0000-\\u001f\\u007f]).*\\S$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "scenario_target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenario_ref",
        "rows"
      ],
      "properties": {
        "scenario_ref": {
          "$ref": "#/$defs/text"
        },
        "rows": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        }
      }
    }
  },
  "properties": {
    "schema_version": {
      "const": "synaptic-dataset-plan/v2"
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id",
        "project_ref",
        "mode",
        "backend",
        "model",
        "output_ref",
        "scenarios",
        "input_dataset_ref",
        "rubric_refs",
        "max_iterations",
        "tags",
        "environment_selection"
      ],
      "properties": {
        "request_id": {
          "$ref": "#/$defs/text"
        },
        "project_ref": {
          "$ref": "#/$defs/text"
        },
        "mode": {
          "enum": [
            "generate",
            "improve"
          ]
        },
        "backend": {
          "$ref": "#/$defs/text"
        },
        "model": {
          "$ref": "#/$defs/text"
        },
        "output_ref": {
          "$ref": "#/$defs/text"
        },
        "scenarios": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/scenario_target"
          }
        },
        "input_dataset_ref": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^(?!\\s)(?!.*[\\u0000-\\u001f\\u007f]).*\\S$"
        },
        "rubric_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/text"
          }
        },
        "max_iterations": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "tags": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/text"
          }
        },
        "environment_selection": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "profile_ref",
            "mode"
          ],
          "properties": {
            "profile_ref": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
            },
            "mode": {
              "enum": [
                "execute",
                "simulate"
              ]
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "generate"
              }
            }
          },
          "then": {
            "properties": {
              "scenarios": {
                "minItems": 1
              },
              "input_dataset_ref": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "improve"
              }
            }
          },
          "then": {
            "properties": {
              "scenarios": {
                "maxItems": 0
              },
              "input_dataset_ref": {
                "type": "string"
              },
              "rubric_refs": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/scenario_target"
      }
    },
    "rows_requested": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "source_digest": {
      "$ref": "#/$defs/digest"
    },
    "environment_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "selection",
        "backend_ref",
        "backend_revision",
        "scope_ref",
        "bounds",
        "allowed_actions",
        "dependencies"
      ],
      "properties": {
        "schema_version": {
          "const": "synaptic-environment-binding/v1"
        },
        "selection": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "profile_ref",
            "mode"
          ],
          "properties": {
            "profile_ref": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
            },
            "mode": {
              "enum": [
                "execute",
                "simulate"
              ]
            }
          }
        },
        "backend_ref": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
        },
        "backend_revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "scope_ref": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
        },
        "bounds": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "max_rows",
            "max_turns",
            "max_tool_calls",
            "max_fixture_files",
            "max_fixture_bytes",
            "max_output_bytes",
            "max_snapshot_bytes",
            "max_seconds"
          ],
          "properties": {
            "max_rows": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000
            },
            "max_turns": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000
            },
            "max_tool_calls": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000
            },
            "max_fixture_files": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000
            },
            "max_fixture_bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 16777216
            },
            "max_output_bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 16777216
            },
            "max_snapshot_bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 16777216
            },
            "max_seconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3600
            }
          }
        },
        "allowed_actions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
          }
        },
        "dependencies": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "role",
              "ref",
              "sha256",
              "size_bytes"
            ],
            "properties": {
              "role": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
              },
              "ref": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "size_bytes": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4194304
              }
            }
          }
        }
      }
    }
  }
}
