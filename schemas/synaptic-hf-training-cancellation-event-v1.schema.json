{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://schemas.synapticlabs.ai/synaptic-hf-training-cancellation-event-v1.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "event_id", "authorization_id", "approval", "submission", "provider_job", "experiment_id", "run_id", "tracking_root_id", "state", "sequence", "occurred_at", "previous_event", "reason_code", "provider_effect_possible"],
  "properties": {
    "schema_version": {"const": "synaptic-hf-training-cancellation-event/v1"}, "event_id": {"$ref": "#/$defs/sha256"}, "authorization_id": {"$ref": "#/$defs/sha256"}, "approval": {"$ref": "#/$defs/artifactRef"}, "submission": {"$ref": "#/$defs/artifactRef"}, "provider_job": {"$ref": "#/$defs/providerJob"},
    "experiment_id": {"$ref": "#/$defs/segment"}, "run_id": {"$ref": "#/$defs/segment"}, "tracking_root_id": {"$ref": "#/$defs/sha256"}, "state": {"enum": ["CLAIMED", "REQUESTED", "NOT_REQUIRED", "AMBIGUOUS"]}, "sequence": {"enum": [1, 2]}, "occurred_at": {"$ref": "#/$defs/timestamp"},
    "previous_event": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/artifactRef"}]}, "reason_code": {"oneOf": [{"type": "null"}, {"enum": ["CANCEL_OUTCOME_AMBIGUOUS", "INTERRUPTED_AFTER_CLAIM", "RECOVERY_EVIDENCE_INVALID", "TERMINAL_ON_REINSPECTION"]}]}, "provider_effect_possible": {"type": "boolean"}
  },
  "allOf": [
    {"if": {"properties": {"state": {"const": "CLAIMED"}}}, "then": {"properties": {"sequence": {"const": 1}, "previous_event": {"type": "null"}, "reason_code": {"type": "null"}, "provider_effect_possible": {"const": true}}}},
    {"if": {"properties": {"state": {"const": "REQUESTED"}}}, "then": {"properties": {"sequence": {"const": 2}, "previous_event": {"$ref": "#/$defs/artifactRef"}, "reason_code": {"type": "null"}, "provider_effect_possible": {"const": true}}}},
    {"if": {"properties": {"state": {"const": "AMBIGUOUS"}}}, "then": {"properties": {"sequence": {"const": 2}, "previous_event": {"$ref": "#/$defs/artifactRef"}, "reason_code": {"type": "string"}, "provider_effect_possible": {"const": true}}}},
    {"if": {"properties": {"state": {"const": "NOT_REQUIRED"}}}, "then": {"properties": {"provider_effect_possible": {"const": false}}}}
  ],
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "segment": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"}, "timestamp": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$"}, "artifactRef": {"type": "object", "additionalProperties": false, "required": ["uri", "sha256"], "properties": {"uri": {"type": "string", "pattern": "^tracking://[A-Za-z0-9][A-Za-z0-9._/-]*$"}, "sha256": {"$ref": "#/$defs/sha256"}}}, "providerJob": {"type": "object", "additionalProperties": false, "required": ["namespace", "job_id", "created_at"], "properties": {"namespace": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"}, "job_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"}, "created_at": {"$ref": "#/$defs/timestamp"}}}}
}
