{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://schemas.synapticlabs.ai/synaptic-hf-training-result-v1.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "result_id", "authorization_id", "approval", "submission", "observation", "provider_job", "experiment_id", "run_id", "tracking_root_id", "state", "occurred_at", "previous_result", "artifact_prefix", "inventory", "optimizer_proof", "publication", "ssh", "ports", "wandb", "job_secrets", "reason_code"],
  "properties": {
    "schema_version": {"const": "synaptic-hf-training-result/v1"}, "result_id": {"$ref": "#/$defs/sha256"}, "authorization_id": {"$ref": "#/$defs/sha256"}, "approval": {"$ref": "#/$defs/artifactRef"}, "submission": {"$ref": "#/$defs/artifactRef"}, "observation": {"$ref": "#/$defs/artifactRef"}, "provider_job": {"$ref": "#/$defs/providerJob"},
    "experiment_id": {"$ref": "#/$defs/segment"}, "run_id": {"$ref": "#/$defs/segment"}, "tracking_root_id": {"$ref": "#/$defs/sha256"}, "state": {"enum": ["VERIFYING", "VERIFIED", "INVALID", "INCONCLUSIVE"]}, "occurred_at": {"$ref": "#/$defs/timestamp"}, "previous_result": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/artifactRef"}]},
    "artifact_prefix": {"type": "object", "additionalProperties": false, "required": ["bucket_id", "base_prefix", "slot_id", "prefix", "pre_download_inventory_sha256", "post_download_inventory_sha256", "verified_inventory_sha256"], "properties": {"bucket_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*/[A-Za-z0-9][A-Za-z0-9._-]*$"}, "base_prefix": {"$ref": "#/$defs/relativePath"}, "slot_id": {"$ref": "#/$defs/sha256"}, "prefix": {"$ref": "#/$defs/relativePath"}, "pre_download_inventory_sha256": {"$ref": "#/$defs/nullableSha256"}, "post_download_inventory_sha256": {"$ref": "#/$defs/nullableSha256"}, "verified_inventory_sha256": {"$ref": "#/$defs/nullableSha256"}}},
    "inventory": {"type": "array", "maxItems": 512, "uniqueItems": true, "items": {"type": "object", "additionalProperties": false, "required": ["path", "bytes", "sha256"], "properties": {"path": {"$ref": "#/$defs/relativePath"}, "bytes": {"type": "integer", "minimum": 0, "maximum": 1073741824}, "sha256": {"$ref": "#/$defs/sha256"}}}},
    "optimizer_proof": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/optimizerProof"}]},
    "publication": {"const": false}, "ssh": {"const": false}, "ports": {"const": false}, "wandb": {"const": false}, "job_secrets": {"type": "array", "maxItems": 0}, "reason_code": {"oneOf": [{"type": "null"}, {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,63}$"}]}
  },
  "allOf": [
    {"if": {"properties": {"state": {"const": "VERIFYING"}}}, "then": {"properties": {"optimizer_proof": {"type": "null"}, "reason_code": {"type": "null"}, "inventory": {"maxItems": 0}, "artifact_prefix": {"properties": {"pre_download_inventory_sha256": {"type": "null"}, "post_download_inventory_sha256": {"type": "null"}, "verified_inventory_sha256": {"type": "null"}}}}}},
    {"if": {"properties": {"state": {"const": "VERIFIED"}}}, "then": {"properties": {"previous_result": {"$ref": "#/$defs/artifactRef"}, "optimizer_proof": {"$ref": "#/$defs/optimizerProof"}, "reason_code": {"type": "null"}, "inventory": {"minItems": 1}, "artifact_prefix": {"properties": {"pre_download_inventory_sha256": {"$ref": "#/$defs/sha256"}, "post_download_inventory_sha256": {"$ref": "#/$defs/sha256"}, "verified_inventory_sha256": {"$ref": "#/$defs/sha256"}}}}}},
    {"if": {"properties": {"state": {"enum": ["INVALID", "INCONCLUSIVE"]}}}, "then": {"properties": {"previous_result": {"$ref": "#/$defs/artifactRef"}, "reason_code": {"type": "string"}}}}
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "nullableSha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}, "segment": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"}, "timestamp": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$"},
    "relativePath": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(?:/[A-Za-z0-9][A-Za-z0-9._-]*)*$", "maxLength": 1024},
    "artifactRef": {"type": "object", "additionalProperties": false, "required": ["uri", "sha256"], "properties": {"uri": {"type": "string", "pattern": "^tracking://[A-Za-z0-9][A-Za-z0-9._/-]*$"}, "sha256": {"$ref": "#/$defs/sha256"}}},
    "providerJob": {"type": "object", "additionalProperties": false, "required": ["namespace", "job_id", "created_at"], "properties": {"namespace": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"}, "job_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"}, "created_at": {"$ref": "#/$defs/timestamp"}}},
    "optimizerProof": {"type": "object", "additionalProperties": false, "required": ["optimizer_boundaries", "global_step", "optimizer_step", "scheduler_step", "loss", "max_steps", "gradient_accumulation_steps", "pre_adapter_sha256", "post_adapter_sha256", "checkpoint_adapter_sha256", "final_adapter_sha256", "trainable_weight_delta"], "properties": {"optimizer_boundaries": {"const": 1}, "global_step": {"const": 1}, "optimizer_step": {"const": 1}, "scheduler_step": {"const": 1}, "loss": {"type": "number"}, "max_steps": {"const": 1}, "gradient_accumulation_steps": {"const": 1}, "pre_adapter_sha256": {"$ref": "#/$defs/sha256"}, "post_adapter_sha256": {"$ref": "#/$defs/sha256"}, "checkpoint_adapter_sha256": {"$ref": "#/$defs/sha256"}, "final_adapter_sha256": {"$ref": "#/$defs/sha256"}, "trainable_weight_delta": {"type": "number", "exclusiveMinimum": 0}}}
  }
}
