{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.synapticlabs.ai/synaptic-chat-turn-v1.schema.json",
  "title": "Synaptic Chat Turn v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "ref", "state", "content_digest", "content"],
  "$defs": {
    "text": {"type": "string", "pattern": "^(?!\\s)(?!.*[\\u0000-\\u001f\\u007f]).*\\S$"},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "count": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807}
  },
  "properties": {
    "schema_version": {"const": "synaptic-chat-turn/v1"},
    "ref": {
      "type": "object", "additionalProperties": false,
      "required": ["session", "request_id"],
      "properties": {
        "session": {
          "type": "object", "additionalProperties": false,
          "required": ["session_id", "project_ref"],
          "properties": {
            "session_id": {"$ref": "#/$defs/text"},
            "project_ref": {"$ref": "#/$defs/text"}
          }
        },
        "request_id": {"type": "integer", "minimum": 1, "maximum": 10000}
      }
    },
    "state": {"enum": ["ready", "closing", "closed", "cleanup_unresolved"]},
    "content_digest": {"$ref": "#/$defs/digest"},
    "content": {"type": "string"},
    "usage": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "availability", "input_tokens", "output_tokens", "cost_minor_units", "currency", "spend"],
      "properties": {
        "schema_version": {"const": "synaptic-usage/v1"},
        "availability": {"const": "measured"},
        "input_tokens": {"$ref": "#/$defs/count"},
        "output_tokens": {"$ref": "#/$defs/count"},
        "cost_minor_units": {"type": ["integer", "null"], "minimum": 0},
        "currency": {"type": ["string", "null"], "pattern": "^[A-Z]{3}$"},
        "spend": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object", "additionalProperties": false,
              "required": ["provider", "account_ref", "spend_id"],
              "properties": {
                "provider": {"$ref": "#/$defs/text"},
                "account_ref": {"$ref": "#/$defs/text"},
                "spend_id": {"$ref": "#/$defs/text"}
              }
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {"properties": {"cost_minor_units": {"type": "integer"}}},
          "then": {"properties": {"currency": {"type": "string"}}}
        },
        {
          "if": {"properties": {"currency": {"type": "string"}}},
          "then": {"properties": {"cost_minor_units": {"type": "integer"}}}
        }
      ]
    }
  }
}
