{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.synapticlabs.ai/synaptic-sft-workload-v1.json",
  "title": "Synaptic SFT Workload v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "entrypoint",
    "provenance",
    "code",
    "runtime",
    "model",
    "dataset",
    "objective",
    "adapter",
    "optimization",
    "logging",
    "checkpoints",
    "artifacts"
  ],
  "properties": {
    "schema_version": {
      "const": "synaptic.sft-workload/v1"
    },
    "kind": {
      "const": "sft"
    },
    "entrypoint": {
      "const": "synaptic.sft.train/v1"
    },
    "provenance": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "class",
            "resolution_attestation_digest",
            "release_manifest_digest"
          ],
          "properties": {
            "class": {
              "const": "live_verified"
            },
            "resolution_attestation_digest": {
              "$ref": "#/$defs/digest"
            },
            "release_manifest_digest": {
              "$ref": "#/$defs/digest"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "class",
            "fixture_manifest_digest"
          ],
          "properties": {
            "class": {
              "const": "fixture_verified"
            },
            "fixture_manifest_digest": {
              "$ref": "#/$defs/digest"
            }
          }
        }
      ]
    },
    "code": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "engine_commit",
        "source_digest"
      ],
      "properties": {
        "engine_commit": {
          "$ref": "#/$defs/revision"
        },
        "source_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dependency_lock_digest"
      ],
      "properties": {
        "dependency_lock_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "revision",
        "tokenizer_revision",
        "trust_remote_code",
        "weights_format"
      ],
      "properties": {
        "repository": {
          "$ref": "#/$defs/repository"
        },
        "revision": {
          "$ref": "#/$defs/revision"
        },
        "tokenizer_revision": {
          "$ref": "#/$defs/revision"
        },
        "trust_remote_code": {
          "const": false
        },
        "weights_format": {
          "const": "safetensors"
        }
      }
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "revision",
        "split",
        "file_selector",
        "record_format"
      ],
      "properties": {
        "repository": {
          "$ref": "#/$defs/repository"
        },
        "revision": {
          "$ref": "#/$defs/revision"
        },
        "split": {
          "type": "string",
          "pattern": "^(?!.*[?#\\\\])[!-~]{1,128}$"
        },
        "file_selector": {
          "type": "string",
          "pattern": "^(?!/)(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9._/-]+\\.(?:json|jsonl)$",
          "maxLength": 512
        },
        "record_format": {
          "const": "conversations"
        }
      }
    },
    "objective": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prompt_render",
        "chat_template",
        "masking_contract",
        "loss_scope",
        "max_seq_length",
        "packing",
        "truncation"
      ],
      "properties": {
        "prompt_render": {
          "const": "full_conversation"
        },
        "chat_template": {
          "const": "tokenizer_embedded_required"
        },
        "masking_contract": {
          "const": "synaptic.sft-mask/conversation-prefix-v1"
        },
        "loss_scope": {
          "enum": [
            "assistant_messages",
            "full_sequence"
          ]
        },
        "max_seq_length": {
          "type": "integer",
          "minimum": 1
        },
        "packing": {
          "const": false
        },
        "truncation": {
          "const": "right"
        }
      }
    },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "target_profile_id",
        "target_profile_digest",
        "target_modules",
        "rank",
        "alpha",
        "dropout",
        "bias",
        "initialization",
        "use_rslora",
        "use_dora"
      ],
      "properties": {
        "type": {
          "const": "lora"
        },
        "target_profile_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "target_profile_digest": {
          "$ref": "#/$defs/digest"
        },
        "target_modules": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_.]{0,127}$"
          }
        },
        "rank": {
          "type": "integer",
          "minimum": 1
        },
        "alpha": {
          "type": "integer",
          "minimum": 1
        },
        "dropout": {
          "$ref": "#/$defs/decimal"
        },
        "bias": {
          "const": "none"
        },
        "initialization": {
          "const": "default"
        },
        "use_rslora": {
          "const": false
        },
        "use_dora": {
          "const": false
        }
      }
    },
    "optimization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "duration",
        "batch_size",
        "gradient_accumulation_steps",
        "learning_rate",
        "warmup_ratio",
        "weight_decay",
        "max_grad_norm",
        "optimizer",
        "scheduler",
        "seed",
        "dtype",
        "model_quantization",
        "gradient_checkpointing"
      ],
      "properties": {
        "duration": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "max_steps"
              ],
              "properties": {
                "max_steps": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "epochs"
              ],
              "properties": {
                "epochs": {
                  "$ref": "#/$defs/positiveDecimal"
                }
              }
            }
          ]
        },
        "batch_size": {
          "type": "integer",
          "minimum": 1
        },
        "gradient_accumulation_steps": {
          "type": "integer",
          "minimum": 1
        },
        "learning_rate": {
          "$ref": "#/$defs/positiveDecimal"
        },
        "warmup_ratio": {
          "$ref": "#/$defs/decimal"
        },
        "weight_decay": {
          "$ref": "#/$defs/decimal"
        },
        "max_grad_norm": {
          "$ref": "#/$defs/positiveDecimal"
        },
        "optimizer": {
          "const": "adamw_8bit"
        },
        "scheduler": {
          "const": "linear"
        },
        "seed": {
          "type": "integer",
          "minimum": 0
        },
        "dtype": {
          "const": "bf16"
        },
        "model_quantization": {
          "const": "none"
        },
        "gradient_checkpointing": {
          "const": "unsloth"
        }
      }
    },
    "logging": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "structured_metrics_steps",
        "external_reporting"
      ],
      "properties": {
        "structured_metrics_steps": {
          "type": "integer",
          "minimum": 1
        },
        "external_reporting": {
          "const": "none"
        }
      }
    },
    "checkpoints": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "strategy",
            "steps",
            "limit",
            "resume"
          ],
          "properties": {
            "strategy": {
              "const": "none"
            },
            "steps": {
              "type": "null"
            },
            "limit": {
              "const": 0
            },
            "resume": {
              "type": "null"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "strategy",
            "steps",
            "limit",
            "resume"
          ],
          "properties": {
            "strategy": {
              "const": "steps"
            },
            "steps": {
              "type": "integer",
              "minimum": 1
            },
            "limit": {
              "type": "integer",
              "minimum": 1
            },
            "resume": {
              "type": "null"
            }
          }
        }
      ]
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_roles"
      ],
      "properties": {
        "required_roles": {
          "const": [
            "workload_record",
            "training_lineage",
            "training_metrics",
            "final_adapter",
            "tokenizer"
          ]
        }
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}/[A-Za-z0-9][A-Za-z0-9._-]{0,95}$"
    },
    "decimal": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*(\\.[0-9]*[1-9])?|0\\.[0-9]*[1-9])$"
    },
    "positiveDecimal": {
      "type": "string",
      "pattern": "^([1-9][0-9]*(\\.[0-9]*[1-9])?|0\\.[0-9]*[1-9])$"
    }
  }
}
