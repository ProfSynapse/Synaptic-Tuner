{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.synapticlabs.ai/synaptic-result-v1.schema.json",
  "title": "Synaptic Result Envelope v1",
  "type": "object",
  "required": ["schema_version", "success", "capability", "run_id", "data", "artifacts", "warnings", "timestamp"],
  "properties": {
    "schema_version": {"const": "synaptic-result/v1"},
    "success": {"type": "boolean"},
    "capability": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "data": {"type": "object"},
    "artifacts": {"type": "array", "items": {"type": "object"}},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "timestamp": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false
}
