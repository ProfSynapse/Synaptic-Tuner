{
  "schema_version": "synaptic-ingestion-cli/v2",
  "project_ref": "public_hf_raw_text_fixture",
  "admission_request_id": "hf_raw_text_admission_v1",
  "request_id": "hf_raw_text_ingestion_v1",
  "admission_limits": {
    "max_member_bytes": 1024,
    "max_total_bytes": 16384
  },
  "discovery": {
    "include": [
      "fixture/practice-*.md"
    ],
    "exclude": [],
    "include_hidden": false
  },
  "structure": {
    "name": "MetricsFixtureText",
    "version": "1",
    "frontmatter_mode": "optional",
    "fields": [
      {
        "name": "body",
        "selector": {
          "kind": "document_body",
          "key": null
        },
        "value_kind": "string",
        "required": true
      },
      {
        "name": "path",
        "selector": {
          "kind": "logical_path",
          "key": null
        },
        "value_kind": "string",
        "required": true
      }
    ],
    "text_projections": [
      {
        "name": "text",
        "field_ref": "body"
      }
    ],
    "metadata": [
      {
        "name": "path",
        "field_ref": "path"
      }
    ]
  },
  "binding": {
    "binding_id": "markdown",
    "pattern": "fixture/*.md"
  }
}
